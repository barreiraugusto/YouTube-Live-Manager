# Variables de entorno para YouTube Live Scheduler
# Copia este archivo a .env y configura tus valores

# Clave secreta para Flask (genera una nueva para producción)
# Python: import secrets; print(secrets.token_hex(32))
FLASK_SECRET_KEY=tu_clave_secreta_muy_segura_aqui

# Configuración de OBS Websocket (opcional, usa valores por defecto si no se especifica)
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Zona horaria para programaciones
TIMEZONE=America/Buenos_Aires

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
